{
  "name": "strangers-eyes-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node ../scripts/check-dist.mjs",
    "prebuild:e2e": "node scripts/copy-assets.mjs",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "tsc -b && node ../scripts/check-boundaries.mjs && node ../scripts/check-prompts.mjs && vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "exifr": "7.1.3",
    "firebase": "13.4.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "oxlint": "1.90.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
